# Port the Node app listens on.
# Plesk sets this automatically in production — only needed locally.
PORT=3001

# MySQL connection for contact form submissions.
# Locally: copy this file to .env next to server/index.ts.
# On Plesk for Windows there is no environment-variable screen, so put these four
# lines in a file called matrix.env in the account's HOME directory (above the web
# root). See DEPLOYMENT.md.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matrix_contact
DB_USER=
DB_PASSWORD=
