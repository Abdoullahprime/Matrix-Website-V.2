# Local development only: port for the development API (npm run server).
PORT=3001

# MySQL connection for contact form submissions.
# Locally: copy this file to .env.
# In production (Plesk) the PHP API reads the same four DB_ keys from a file called
# matrix.env in the account's HOME directory, above the website folder. See DEPLOYMENT.md.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matrix_contact
DB_USER=
DB_PASSWORD=

# Email notifications (production PHP API only; the development server does not send mail).
# Set these in matrix.env on the server, never in a committed file. See DEPLOYMENT.md.
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_TO=info@matrixgambia.com
