# Port the Node app listens on.
# Plesk sets this automatically in production — only needed locally.
PORT=3001

# MySQL connection for contact form submissions.
# In Plesk these go in: Websites & Domains > Node.js > Custom environment variables
# (preferred over uploading a .env file).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=matrix_contact
DB_USER=
DB_PASSWORD=
